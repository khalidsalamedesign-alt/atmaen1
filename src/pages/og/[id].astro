---
// قالب صورة المشاركة (1200×630). يُصوَّر بـ scripts/gen-images.mjs إلى public/og/*.png
// ليس جزءاً من التنقل ولا الـ sitemap.
import '@fontsource-variable/readex-pro';
import { allCases } from '../../lib/util';
import { categories } from '../../data/taxonomy';

export function getStaticPaths() {
  return [
    { params: { id: 'site' }, props: { title: 'الإسعافات الأولية والطوارئ المنزلية', sub: 'خطوات واضحة وقت الحاجة — تعمل حتى بدون إنترنت', tag: 'مرجع عربي مبسّط', crit: false } },
    ...allCases.map((c) => ({
      params: { id: c.id },
      props: { title: c.title, sub: c.summary, tag: categories.find((x) => x.id === c.category)!.name, crit: c.urgency === 'critical' },
    })),
  ];
}
const { title, sub, tag, crit } = Astro.props;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <style>
    html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; }
    body {
      font-family: 'Readex Pro Variable', Tahoma, sans-serif; color: #fff;
      background:
        radial-gradient(520px 380px at 0% 110%, rgba(43, 196, 160, .55), transparent 70%),
        radial-gradient(600px 400px at 110% -20%, rgba(19, 144, 127, .45), transparent 70%),
        linear-gradient(135deg, #062f33 0%, #0a5c63 100%);
      display: flex; flex-direction: column; justify-content: space-between; padding: 64px 76px; box-sizing: border-box;
    }
    .top { display: flex; align-items: center; gap: 18px; font-size: 40px; font-weight: 700; }
    .logo { width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center; background: linear-gradient(135deg, #0a5c63, #13907f 55%, #2bc4a0); box-shadow: 0 10px 30px -10px rgba(43, 196, 160, .9), inset 0 1px 0 rgba(255,255,255,.3); }
    .tags { display: flex; gap: 12px; margin-bottom: 22px; }
    .tag { font-size: 26px; padding: 6px 22px; border-radius: 999px; background: rgba(255, 255, 255, .14); }
    .tag.crit { background: #c8232c; font-weight: 700; }
    h1 { margin: 0; font-size: 96px; line-height: 1.15; font-weight: 700; letter-spacing: -.01em; }
    p { margin: 18px 0 0; font-size: 36px; line-height: 1.5; color: rgba(255, 255, 255, .82); max-width: 960px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .foot { display: flex; justify-content: space-between; align-items: center; font-size: 26px; color: rgba(255, 255, 255, .75); }
    .foot b { color: #7de8d2; font-weight: 500; }
  </style>
</head>
<body>
  <div class="top">
    <span class="logo"><svg width="36" height="36" viewBox="0 0 24 24" fill="#fff"><path d="M9.5 3h5v6.5H21v5h-6.5V21h-5v-6.5H3v-5h6.5z"/></svg></span>
    اطمئن
  </div>
  <div>
    <div class="tags">
      {crit && <span class="tag crit">حالة حرجة</span>}
      <span class="tag">{tag}</span>
    </div>
    <h1>{title}</h1>
    <p>{sub}</p>
  </div>
  <div class="foot">
    <span>الخطوات · متى تتصل بالإسعاف · أخطاء لا تفعلها</span>
    <b>الإسعافات الأولية بالعربي</b>
  </div>
</body>
</html>
