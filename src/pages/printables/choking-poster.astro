---
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import { getCase, arNum } from '../../lib/util';

const adult = getCase('choking-adult')!;
const infant = getCase('choking-infant')!;
// نسخة مختصرة: الخطوات الأساسية فقط (بدون الخطوة الأولى «شجّعه يسعل» والأخيرة تُعرض كتنبيه)
const pick = (c: typeof adult) => c.steps.slice(1, -1).map((s) => s.text);
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ملصق خطوات الاختناق — اطمئن</title>
  <meta name="robots" content="noindex" />
  <style>
    @page { size: A4; margin: 10mm; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'IBM Plex Sans Arabic', Tahoma, sans-serif; color: #111; background: #ddd; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .sheet { width: 210mm; min-height: 297mm; margin: 1rem auto; background: #fff; padding: 12mm; display: flex; flex-direction: column; gap: 6mm; }
    h1 { margin: 0; font-size: 34pt; line-height: 1.1; }
    .call { background: #b3261e; color: #fff; border-radius: 4mm; padding: 5mm 7mm; font-size: 17pt; font-weight: 700; display: flex; justify-content: space-between; align-items: center; gap: 4mm; }
    .call .blank { background: #fff; color: #b3261e; border-radius: 2mm; padding: 1mm 8mm; min-width: 40mm; text-align: center; font-size: 22pt; }
    .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 6mm; flex: 1; }
    section { border: 1.2mm solid #111; border-radius: 4mm; padding: 5mm; }
    h2 { margin: 0 0 3mm; font-size: 19pt; }
    h2 small { font-size: 11pt; font-weight: 400; }
    ol { list-style: none; margin: 0; padding: 0; }
    li { display: grid; grid-template-columns: 11mm 1fr; gap: 3mm; margin-bottom: 3.5mm; font-size: 13pt; font-weight: 700; line-height: 1.45; }
    li b { display: grid; place-items: center; width: 10mm; height: 10mm; border-radius: 50%; background: #1d6b3f; color: #fff; font-size: 15pt; }
    .dont { background: #fff4de; border: 1.2mm solid #f0b44c; border-radius: 4mm; padding: 4mm 6mm; font-size: 12.5pt; }
    .dont strong { font-size: 15pt; color: #8a4b00; }
    .foot { font-size: 9.5pt; color: #444; display: flex; justify-content: space-between; gap: 4mm; }
    .bar { text-align: center; padding: .8rem; font-family: inherit; }
    .bar button { font: inherit; font-size: 1.1rem; font-weight: 700; padding: .6rem 1.4rem; border-radius: 10px; border: 0; background: #0e5a64; color: #fff; cursor: pointer; }
    @media print { body { background: #fff; } .sheet { margin: 0; width: auto; min-height: auto; height: 277mm; padding: 0; } .bar { display: none; } }
  </style>
</head>
<body>
  <div class="bar"><button onclick="window.print()">اطبع الملصق</button> · <a href="/printables">رجوع</a></div>
  <div class="sheet">
    <h1>شخص يختنق؟</h1>
    <div class="call">
      <span>ما يقدر يتكلم أو يسعل أو صار أزرق؟ اتصل فوراً</span>
      <span class="blank">&nbsp;</span>
    </div>
    <div class="cols">
      <section>
        <h2>طفل وبالغ <small>(أكبر من سنة — للطفل انزل لمستواه)</small></h2>
        <ol>{pick(adult).map((t, i) => <li><b>{arNum(i + 1)}</b><span>{t}</span></li>)}</ol>
      </section>
      <section>
        <h2>رضيع <small>(أقل من سنة)</small></h2>
        <ol>{pick(infant).map((t, i) => <li><b>{arNum(i + 1)}</b><span>{t}</span></li>)}</ol>
      </section>
    </div>
    <div class="dont">
      <strong>⚠ لا تفعل:</strong> لا تدخل إصبعك عشوائياً · لا تعطيه ماء · لا ضغطات بطن للرضيع ·
      <strong>إذا فقد الوعي:</strong> اتصل وابدأ الإنعاش.
    </div>
    <div class="foot">
      <span>اطمئن — الإسعافات الأولية والطوارئ المنزلية</span>
      <span>مسوّدة غير مراجعة طبياً — لا تُطبع للتوزيع قبل المراجعة</span>
    </div>
  </div>
  <script is:inline>
    // تصغير الملصق ليناسب شاشة الجوال — الطباعة تبقى بحجم A4
    (function () {
      var s = document.querySelector('.sheet');
      function fit() { s.style.zoom = ''; var w = s.offsetWidth + 16; if (innerWidth < w) s.style.zoom = String(innerWidth / w); }
      fit(); addEventListener('resize', fit);
      addEventListener('beforeprint', function () { s.style.zoom = ''; });
      addEventListener('afterprint', fit);
    })();
  </script>
</body>
</html>
